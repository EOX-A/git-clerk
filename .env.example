#Create `.env` file in root, copy-paste env given below and also update the variables with your respective data
GITCLERK_GITHUB_TOKEN=ghp_***add-your-token***
GITCLERK_GITHUB_REPO=***add-owner/repo***
# V2 user profile. Username should match the workspace identity used for branch isolation.
GITCLERK_USERNAME=
GITCLERK_EMAIL=
GITCLERK_PROFILE_NAME=
# V2 chat endpoint is configured in public/config-v2.js: gitClerkConfig.chat.backend.baseUrl
